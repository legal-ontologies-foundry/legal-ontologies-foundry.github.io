{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/lof/registry_schema.json",
  "title": "Legal Ontologies Foundry registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "preferred_prefix", "title", "description", "domain",
               "jurisdictions", "status", "activity_status", "repository",
               "tracker", "license", "contact"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
    "preferred_prefix": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*$"},
    "title": {"type": "string", "minLength": 3},
    "description": {"type": "string", "minLength": 10},
    "domain": {"type": "string"},
    "jurisdictions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["draft", "candidate", "accepted", "deprecated"]},
    "activity_status": {"enum": ["active", "inactive", "orphaned"]},
    "homepage": {"type": "string", "format": "uri"},
    "repository": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"},
    "tracker": {"type": "string", "format": "uri"},
    "branch": {"type": "string"},
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {"enum": ["CC BY 4.0", "CC0 1.0"]},
        "url": {"enum": ["https://creativecommons.org/licenses/by/4.0/",
                         "https://creativecommons.org/publicdomain/zero/1.0/"]}
      }
    },
    "contact": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "email", "github"],
      "properties": {
        "label": {"type": "string"},
        "email": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"},
        "github": {"type": "string"},
        "orcid": {"type": "string"}
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "object", "required": ["id"], "additionalProperties": false,
                "properties": {"id": {"type": "string"}}}
    },
    "usages": {
      "type": "array",
      "items": {"type": "object", "required": ["description"], "additionalProperties": false,
                "properties": {"description": {"type": "string"}, "url": {"type": "string"}}}
    },
    "publications": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "title"], "additionalProperties": false,
                "properties": {"id": {"type": "string"}, "title": {"type": "string"}}}
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "properties": {"date": {"type": "string"}, "issue": {"type": "string"}}
    },
    "replaced_by": {"type": "string"}
  }
}
